    "glossary": [
      {
        "term": "Score",
        "definition": "An ippon, waza-ari or yuko awarded to an athlete. Walkovers and withdrawals are not scores."
      },
      {
        "term": "Share (by event)",
        "definition": "Scores with the technique divided by all scores in the filter."
      },
      {
        "term": "Share (by athlete)",
        "definition": "Athletes who scored at least once with the technique divided by all athletes who scored. Shows how widespread a technique is, not how often it is used."
      },
      {
        "term": "Ippon / waza-ari / yuko breakdown",
        "definition": "How the technique's scores split by score value. Only comparable within the same score scale."
      },
      {
        "term": "Waza-ari awasete ippon",
        "definition": "A second waza-ari, which always ends the contest. Counted as waza-ari."
      },
      {
        "term": "Unknown technique",
        "definition": "A score recorded without a technique tag."
      },
      {
        "term": "Side",
        "definition": "The side the technique was performed on (left/right), not the athlete's stance."
      },
      {
        "term": "Technique type",
        "definition": "Standing (tachi-waza) or ground (ne-waza) technique. With Standing or Ground selected, scores without a technique are left out, so shares are computed on fewer scores than with All and look higher."
      },
      {
        "term": "Repertoire",
        "definition": "The techniques an athlete scored with at least 2 times in the filter."
      },
      {
        "term": "Lift",
        "definition": "How much more often two things occur together than expected by chance, compared with what is expected in the same weight categories. 1 = as expected, 2 = twice as often."
      },
      {
        "term": "Support",
        "definition": "The number of athletes behind a repertoire or counter value."
      },
      {
        "term": "Specialist",
        "definition": "An athlete whose main technique accounts for at least 40% of their scores."
      },
      {
        "term": "Counter",
        "definition": "Techniques that score against specialists of a technique more often than against everyone else."
      },
      {
        "term": "Hold-down scores",
        "definition": "For osaekomi techniques, ippon/waza-ari/yuko depend on how long the hold lasted, not on the quality of the entry."
      },
      {
        "term": "Sample status",
        "definition": "ok, small or insufficient, depending on how many scores or athletes are behind a value."
      },
      {
        "term": "Ruleset",
        "definition": "A period with the same scoring rules (e.g. 2025–, with yuko)."
      },
      {
        "term": "Similar athletes",
        "definition": "Athletes whose technique profile (how many scores they made with each technique) is closest to this athlete's, by cosine similarity. 100% = same proportions."
      },
      {
        "term": "Limits of the data",
        "definition": "Techniques are tagged by hand by IJF operators, and one tag can cover several variants: \"Seoi-nage\" covers ippon-seoi-nage, morote-seoi-nage and their drop variants. Tagging habits can change over the years, so a trend can reflect the tagging as well as the judo. The data describes elite senior competitors: what scores for them is not necessarily what works for every judoka."
      },
      {
        "term": "Competition level",
        "definition": "Elite (Olympic Games, World Championships, Masters, Grand Slam, Grand Prix, continental championships) or continental (Opens, Cups and other events). Competitions are included by their data, not by their level."
      }
    ]
  }
}
